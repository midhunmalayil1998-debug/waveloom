<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10241B"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_app_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WAVELOOM · MALAYALAM RADIO"
        android:textColor="#6EE7B7"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_station_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tap to open Waveloom"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_prev_btn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="#1E3A2F"
            android:text="⏮ Prev"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_play_btn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1.3"
            android:backgroundTint="#6EE7B7"
            android:text="⏯ Play / Pause"
            android:textColor="#10241B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_next_btn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="#1E3A2F"
            android:text="Next ⏭"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
